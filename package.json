{
  "name": "mail-mime-builder",
  "version": "1.0.4",
  "description": "RFC-2822, RFC-2045 and RFC-2049 compliant zero dependency raw email message generator.",
  "type": "module",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shyim/mail-mime-builder.git"
  },
  "keywords": [
    "email-message"
  ],
  "devDependencies": {
    "tshy": "^4.1.3",
    "typescript": "^7.0.2"
  },
  "author": "Soner Sayakci <github@shyim.de>",
  "license": "MIT",
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "scripts": {
    "prepare": "tshy",
    "test": "node --test tests/*.spec.js"
  }
}
